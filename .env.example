# ==========================================
# Railway Backend Environment Variables
# ==========================================

# Port automatically provided by Railway, default 4001
PORT=4001
HOST=0.0.0.0
NODE_ENV=production

# PostgreSQL Database (Provided by Railway Postgres Plugin or External)
# Example: postgresql://postgres:password@roundhouse.proxy.rlwy.net:12345/railway
DATABASE_URL=postgresql://cricket:cricket_secret@localhost:5433/livecricket?schema=public

# Redis Cache (Provided by Railway Redis Plugin or External)
# Example: redis://default:password@roundhouse.proxy.rlwy.net:6379
REDIS_URL=redis://localhost:6379

# Allowed Vercel Frontend Origin(s) for CORS
WEB_ORIGIN=http://localhost:3001
FRONTEND_URL=https://your-frontend-vercel.vercel.app

# CricketData.org Multi-Key Failover Pool
CRICKET_PROVIDER=cricketdata
CRICKET_API_KEYS=f35f0f5a-d337-4ead-a0ba-787f8f990e3d,2633dd87-4207-40af-95d0-4a68f7a12c87,1577311c-753b-4ac3-94b5-a5384079e793
PROVIDER_DAILY_BUDGET=300
PROVIDER_SAFETY_MARGIN=0.8
POLL_INTERVAL_LIVE_MS=2000
POLL_INTERVAL_MS=2000
ADMIN_TOKEN=livecricket-admin-secret-2026
